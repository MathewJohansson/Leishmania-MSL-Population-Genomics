# V-notation = AM-notation confirmed (V5 = AM5 etc.)
q_del <- c(
V1  = 1.0000,
V2  = 0.3533,
V3  = 1.0000,
V4  = 0.0417,
V5  = 0.8036,
V6  = 1.0000,
V7  = 1.0000,
V8  = 0.0500,
V9  = 1.0000,
V10 = 1.0000,
V11 = 1.0000,
V12 = 1.0000,
V13 = 0.0000
)
