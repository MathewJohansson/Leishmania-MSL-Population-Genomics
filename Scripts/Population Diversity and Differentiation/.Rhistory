print("Filtering dataset for MSL0 strains only...")
# 1. Filter metadata to ONLY include MSL 0 strains
meta_msl0_only <- meta_combined |>
filter(MSL_coverage_rounded == 0)
# 2. Subset the dosage matrix to these MSL0 samples
dosage_msl0 <- dosage_filtered[rownames(dosage_filtered) %in% meta_msl0_only$sra_run_accession, ]
# 3. Recalculate variance (Crucial: we must drop SNPs that were only variant because of MSL4 strains!)
col_vars_msl0 <- apply(dosage_msl0, 2, var, na.rm = TRUE)
keep_cols_msl0 <- !is.na(col_vars_msl0) & col_vars_msl0 > 0
dosage_msl0_clean <- dosage_msl0[, keep_cols_msl0]
print(paste("MSL0 Samples:", nrow(dosage_msl0_clean)))
print(paste("Informative SNPs within MSL0 Clade:", ncol(dosage_msl0_clean)))
# 4. Convert to StAMPP Format
allele_freqs_msl0 <- dosage_msl0_clean / 4
stampp_df_msl0 <- as.data.frame(allele_freqs_msl0)
stampp_df_msl0$Sample <- rownames(stampp_df_msl0)
stampp_df_msl0 <- stampp_df_msl0 |>
left_join(meta_msl0_only |> select(sra_run_accession, population),
by = c("Sample" = "sra_run_accession")) |>
rename(Pop = population) |>
mutate(Ploidy = 4, Format = "freq") |>
select(Sample, Pop, Ploidy, Format, all_of(colnames(allele_freqs_msl0)))
stampp_obj_msl0 <- stamppConvert(stampp_df_msl0, type = "r")
# 5. Calculate Distance and Build NJ Tree
print("Calculating Nei's Distance for MSL0 strains...")
nei_dist_msl0 <- stamppNeisD(stampp_obj_msl0, pop = FALSE)
nj_tree_msl0 <- nj(as.dist(nei_dist_msl0))
# 6. Plotting the MSL0-Only Tree by Population
tree_meta_msl0 <- meta_msl0_only |>
select(sra_run_accession, population) |>
distinct() |>
mutate(population = factor(population, levels = mixedsort(unique(population))))
nj_plot_msl0_pops <- suppressWarnings(
ggtree(nj_tree_msl0, layout = "daylight") %<+% tree_meta_msl0 +
geom_tippoint(aes(color = population), size = 3, alpha = 0.9) +
scale_color_manual(values = my_cols_no_grey, name = "Population") +
theme(
legend.position = "right",
title = element_text(size = 14, face = "bold")
) +
ggtitle("Genetic Structure of MSL-0 Strains", subtitle = "Testing East-to-Inland Migration Hypothesis") +
guides(color = guide_legend(override.aes = list(size = 4)))
)
# 2. Add the geographic zone to the MSL0 metadata
tree_meta_msl0_geo <- tree_meta_msl0 |>
mutate(
geographic_zone = if_else(
population %in% inland_pops,
"Inland/North (Expansion Zone)",
"East Coast/South (Established Zone)"
),
# Convert to factor so Coastal shows up first in legends
geographic_zone = factor(geographic_zone, levels = c("East Coast/South (Established Zone)", "Inland/North (Expansion Zone)"))
)
