source("~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Scripts/Phylogenetic Scripts/NJ Trees/tetraploid_nei_genetic_distance.Americas.R", echo = TRUE)
# Save all the distance and tree data
save.image("Data/tetraploid_Neis.RData")
# Save all the distance and tree data
save.image("/Data/tetraploid_Neis.RData")
load("/Data/tetraploid_Neis.RData")
# 1. Define your geographic categories
# UPDATE THESE with the exact AM codes for Mato Grosso, Maranhão, and Piauí
inland_pops <- c("AM1", "AM10", "AM11") # North populations (V1/V10/V11)
coastal_pops <- c("AM2", "AM6", "AM9")  # East coast/south populations (V2/V6/V9)
# 2. Add the geographic zone to the MSL0 metadata
tree_meta_msl0_geo <- tree_meta_msl0 |>
mutate(
geographic_zone = if_else(
population %in% inland_pops,
"Inland/North (Expansion Zone)",
"East Coast/South (Established Zone)"
),
geographic_zone = factor(geographic_zone, levels = c("East Coast/South (Established Zone)", "Inland/North (Expansion Zone)"))
)
# 3. Build the Geographic Tree
# We will use color to show the broad Geographic Zone, and keep the exact Population as text labels (optional, but helpful)
nj_plot_msl0_geo <- suppressWarnings(
ggtree(nj_tree_msl0, layout = "daylight") %<+% tree_meta_msl0_geo +
# Map both color and shape to the zone so it's incredibly distinct
geom_tippoint(aes(color = geographic_zone, shape = geographic_zone), size = 3.5, alpha = 0.9) +
# Use distinct, narrative-driven colors: Blue for established coast, Gold/Orange for the inland expansion
scale_color_manual(values = c("East Coast/South (Established Zone)" = "#4575b4",
"Inland/North (Expansion Zone)" = "#fdae61")) +
# 16 is a solid circle, 17 is a solid triangle
scale_shape_manual(values = c(16, 17)) +
theme(
legend.position = "bottom",
legend.title = element_blank(), # Hide the legend title for a cleaner look
legend.text = element_text(size = 12, face = "bold"),
title = element_text(size = 15, face = "bold")
) +
ggtitle("Phylogeography of MSL-0 Deletion Strains",
subtitle = "Testing nesting of Inland expansion clades within East Coast lineages")
)
# Print to viewer
print(nj_plot_msl0_geo)
# Save the plot
ggsave("/home/johansson/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Figures/Phylogenetics Work/NJ Trees/Chr31/tetraploid_chr31_NJ_tree_MSL0_Geographic.jpeg",
plot = nj_plot_msl0_geo, width = 12, height = 12, dpi = 300)
print("Geographic MSL0 tree plotted and saved!")
# Save all the distance and tree data
save.image("rdata/tetraploid_Neis.RData")
# Save all the distance and tree data
save.image("~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Data/tetraploid_Neis.RData")
load("~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Data/tetraploid_Neis.RData")
library(ape)
dist_matrix <- read.table(
"~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Data/tetraploid_chr31_Neis_distance.txt",
header = FALSE, skip = 1, row.names = 1
)
dist_obj <- as.dist(as.matrix(dist_matrix))
write.nexus.dist(dist_obj,
file = "~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Data/tetraploid_chr31_Neis_distance.nex")
write.nexus.dist <- function(x, file) {
x <- as.matrix(x)
n <- nrow(x)
cat("#NEXUS\n", file = file)
cat("BEGIN Taxa;\n", file = file, append = TRUE)
cat(paste0("DIMENSIONS ntax=", n, ";\n"), file = file, append = TRUE)
cat("TAXLABELS\n", file = file, append = TRUE)
for (nm in rownames(x)) cat(paste0("[", which(rownames(x)==nm), "] '", nm, "'\n"), file = file, append = TRUE)
cat(";\nEND;\n\n", file = file, append = TRUE)
cat("BEGIN Distances;\n", file = file, append = TRUE)
cat(paste0("DIMENSIONS ntax=", n, ";\n"), file = file, append = TRUE)
cat("FORMAT labels=left diagonal triangle=both;\n", file = file, append = TRUE)
cat("MATRIX\n", file = file, append = TRUE)
for (i in 1:n) {
cat(paste0("'", rownames(x)[i], "'"), file = file, append = TRUE)
cat(paste0(" ", formatC(x[i,], format="f", digits=5)), file = file, append = TRUE)
cat("\n", file = file, append = TRUE)
}
cat(";\nEND;\n", file = file, append = TRUE)
}
write.nexus.dist(dist_obj,
file = "~/Documents/Bioinformatics/Leishmania/Leishmania Manuscript/Data/tetraploid_chr31_Neis_distance.nex")
