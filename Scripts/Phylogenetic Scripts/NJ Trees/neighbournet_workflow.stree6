#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=7 nAlgorithms=5;
PROGRAM version='SplitsTree App (version 6.7.5, built 18 Feb 2026)';
WORKFLOW creationDate='1778663574355'; [Wed May 13 10:12:54 BST 2026]
END; [SPLITSTREE6]

BEGIN TAXA;
TITLE 'Input Taxa';
LINK ALGORITHM = 'Input Data Loader';
DIMENSIONS ntax=0;
TAXLABELS
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
LINK ALGORITHM = 'Input Data Loader';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=0;
TAXLABELS
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN DISTANCES;
TITLE 'Input Distances';
LINK ALGORITHM = 'Input Data Loader';
DIMENSIONS ntax=0;
FORMAT labels=left diagonal triangle=Both;
MATRIX
;
END; [DISTANCES]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK DISTANCES = 'Input Distances';
NAME 'Distances Taxa Filter';
END; [ALGORITHM]

BEGIN DISTANCES;
TITLE 'Working Distances';
LINK ALGORITHM = 'Input Data Filter';
DIMENSIONS ntax=0;
FORMAT labels=left diagonal triangle=Both;
MATRIX
;
END; [DISTANCES]

BEGIN ALGORITHM;
TITLE 'Neighbor Net';
LINK DISTANCES = 'Working Distances';
NAME 'Neighbor Net';
OPTIONS
	InferenceAlgorithm = 'ActiveSet';
END; [ALGORITHM]

BEGIN SPLITS;
TITLE 'Splits';
LINK ALGORITHM = 'Neighbor Net';
DIMENSIONS ntax=0 nsplits=0;
FORMAT labels=no weights=yes confidences=no;
PROPERTIES fit=-1;
MATRIX
;
END; [SPLITS]

BEGIN ALGORITHM;
TITLE 'Show Splits';
LINK SPLITS = 'Splits';
NAME 'Show Splits';
OPTIONS
	View = 'SplitNetwork';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'SplitNetwork';
LINK ALGORITHM = 'Show Splits';
NAME 'ViewView';
INPUT 'SPLITS';
END; [VIEW]
