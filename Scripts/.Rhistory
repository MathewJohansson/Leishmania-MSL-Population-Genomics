# --- AM5-based non-WFR (comparisons 1, 3-6) ---
comp1  <- run_windowed_metrics(ids_WFR2_MSL4, ids_WFR1_MSL4,  "WFR2_MSL4",       "WFR1_MSL4")        # neutral baseline
comp3  <- run_windowed_metrics(ids_WFR1_MSL4, ids_AM5_MSL0,   "WFR1_MSL4",       "nonWFR_AM5_MSL0")  # unrelated control
comp4  <- run_windowed_metrics(ids_WFR2_MSL4, ids_AM5_MSL0,   "WFR2_MSL4",       "nonWFR_AM5_MSL0")  # unrelated control
comp5  <- run_windowed_metrics(ids_WFR1_MSL0, ids_AM5_MSL0,   "WFR1_MSL0",       "nonWFR_AM5_MSL0")  # KEY TEST (AM5)
comp6  <- run_windowed_metrics(ids_WFR1_MSL4, ids_AM5_MSL4,   "WFR1_MSL4",       "nonWFR_AM5_MSL4")  # neutral MSL4 control
# --- Geographic non-WFR (comparisons 7-10) ---
comp7  <- run_windowed_metrics(ids_WFR1_MSL4, ids_geo_MSL0,   "WFR1_MSL4",       "nonWFR_geo_MSL0")  # unrelated control
comp8  <- run_windowed_metrics(ids_WFR2_MSL4, ids_geo_MSL0,   "WFR2_MSL4",       "nonWFR_geo_MSL0")  # unrelated control
comp9  <- run_windowed_metrics(ids_WFR1_MSL0, ids_geo_MSL0,   "WFR1_MSL0",       "nonWFR_geo_MSL0")  # KEY TEST (geo)
comp10 <- run_windowed_metrics(ids_WFR1_MSL4, ids_geo_MSL4,   "WFR1_MSL4",       "nonWFR_geo_MSL4")  # neutral MSL4 control
all_comps <- bind_rows(comp1, comp3, comp4, comp5, comp6,
comp7, comp8, comp9, comp10)
write_tsv(all_comps, file.path(OUT_DIR, paste0("windowed_dxy_fst_chr31_", Sys.Date(), ".tsv")))
cat("Full chr31 results saved.\n")
summarise_dxy <- function(df, label) {
msl_start <- 1181282
msl_end   <- 1192406
flank_pad <- 50000
df <- df |>
mutate(region = case_when(
window_mid >= msl_start & window_mid <= msl_end ~ "MSL_locus",
window_mid >= (msl_start - flank_pad) & window_mid <= (msl_end + flank_pad) ~ "MSL_flanking",
TRUE ~ "background"
))
df |>
group_by(region) |>
summarise(
n_windows = n(),
mean_dxy  = round(mean(dxy, na.rm = TRUE), 6),
.groups   = "drop"
) |>
mutate(comparison = label) |>
select(comparison, region, n_windows, mean_dxy)
}
# Load saved TSV — update date to match output from Section 10
all_comps <- read_tsv(file.path(OUT_DIR, paste0("windowed_dxy_fst_chr31_", Sys.Date(), ".tsv")),
show_col_types = FALSE)
all_summaries <- bind_rows(
summarise_dxy(filter(all_comps, pop1 == "WFR2_MSL4"  & pop2 == "WFR1_MSL4"),        "Comp1  — WFR1_MSL4 vs WFR2_MSL4 (neutral baseline)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL4"  & pop2 == "nonWFR_AM5_MSL0"),  "Comp3  — WFR1_MSL4 vs nonWFR_AM5_MSL0 (unrelated control)"),
summarise_dxy(filter(all_comps, pop1 == "WFR2_MSL4"  & pop2 == "nonWFR_AM5_MSL0"),  "Comp4  — WFR2_MSL4 vs nonWFR_AM5_MSL0 (unrelated control)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL0"  & pop2 == "nonWFR_AM5_MSL0"),  "Comp5  — WFR1_MSL0 vs nonWFR_AM5_MSL0 (KEY TEST AM5)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL4"  & pop2 == "nonWFR_AM5_MSL4"),  "Comp6  — WFR1_MSL4 vs nonWFR_AM5_MSL4 (neutral MSL4 control)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL4"  & pop2 == "nonWFR_geo_MSL0"),  "Comp7  — WFR1_MSL4 vs nonWFR_geo_MSL0 (unrelated control)"),
summarise_dxy(filter(all_comps, pop1 == "WFR2_MSL4"  & pop2 == "nonWFR_geo_MSL0"),  "Comp8  — WFR2_MSL4 vs nonWFR_geo_MSL0 (unrelated control)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL0"  & pop2 == "nonWFR_geo_MSL0"),  "Comp9  — WFR1_MSL0 vs nonWFR_geo_MSL0 (KEY TEST geo)"),
summarise_dxy(filter(all_comps, pop1 == "WFR1_MSL4"  & pop2 == "nonWFR_geo_MSL4"),  "Comp10 — WFR1_MSL4 vs nonWFR_geo_MSL4 (neutral MSL4 control)")
)
print(all_summaries, n = Inf)
write_tsv(all_summaries, file.path(OUT_DIR, paste0("dxy_summary_by_region_", Sys.Date(), ".tsv")))
cat("Summary saved.\n")
