nj_plot.populations <- suppressWarnings(
ggtree(nj_tree, layout = "daylight") %<+% tree_meta +
geom_tippoint(aes(color = ifelse(is.na(population), "NA", as.character(population))),
size = 2.5, alpha = 0.8) +
scale_color_manual(values = pop_colours_with_na, name = "Population",
breaks = names(pop_colours_present)) +
theme(legend.position = "right",
legend.text  = element_text(size = 10),
legend.title = element_text(size = 12)) +
guides(color = guide_legend(override.aes = list(size = 4)))
)
